{
  "name": "@fortsprite/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "pnpm dlx @better-auth/cli@latest generate --config src/auth.ts --output src/db/auth-schema.ts --yes",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "catalog:import": "tsx scripts/import-catalog.ts",
    "auth:remove-legacy-epic-user": "tsx scripts/remove-legacy-epic-user.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@better-auth/passkey": "1.7.5",
    "@better-auth/utils": "0.4.2",
    "@hono/node-server": "^2.1.0",
    "@workspace/contracts": "workspace:*",
    "better-auth": "^1.7.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./app": "./src/app.ts"
  }
}
