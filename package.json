    "test": "turbo run test",
    "security:audit": "pnpm audit --audit-level=low"
  },
  "devDependencies": {
    "oxlint": "1.87.0",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "dependencies": {
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3"
  }
}
